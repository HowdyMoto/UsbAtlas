<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>UsbAtlas</AssemblyName>
    <Version>1.6.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- The .exe's icon, for Explorer, Start and a pinned taskbar button; the window shows the same one. -->
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Authors>Wright Bagwell</Authors>
    <Copyright>Copyright (c) 2026 Wright Bagwell</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HowdyMoto/UsbAtlas</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UsbAtlas.Core\UsbAtlas.Core.csproj" />
    <!-- Ships atlascli.exe beside the app; the app doesn't use its code. -->
    <ProjectReference Include="..\UsbAtlas.Cli\UsbAtlas.Cli.csproj" />
    <None Include="..\..\LICENSE;..\..\THIRD-PARTY-NOTICES.md" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Resource Include="Assets\Fonts\*.ttf" />
    <Resource Include="Assets\AppIcon.ico" />
    <None Update="Assets\Fonts\OFL.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Update="Assets\Icons\LICENSE.txt;Assets\Icons\NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
