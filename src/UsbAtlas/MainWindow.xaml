<Window x:Class="UsbAtlas.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="USB Atlas" Icon="pack://application:,,,/Assets/AppIcon.ico" Width="1500" Height="940" MinWidth="1050" MinHeight="650" Background="{DynamicResource WindowSurface}" FontFamily="{StaticResource UiFont}" FontSize="13" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" PreviewKeyDown="WindowKeyDown">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/><RowDefinition Height="30"/></Grid.RowDefinitions>
  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,0">
   <Grid x:Name="TitleBar" SizeChanged="TitleBarSizeChanged">
    <StackPanel x:Name="TitleLeft" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" SizeChanged="TitleBarSizeChanged">
     <TextBlock Text="USB Atlas" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
     <Button x:Name="TreeButton" Visibility="Collapsed" Content="Show devices" Click="TreePanelClick" Padding="8,4" Margin="14,0,0,0" ToolTip="Show or hide the device tree"/>
    </StackPanel>
    <Grid x:Name="SearchBox" Width="340" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center">
     <TextBox x:Name="Search" Background="{DynamicResource SearchField}" BorderBrush="{DynamicResource SearchEdge}" TextChanged="SearchChanged" KeyDown="SearchKeyDown" ToolTip="Search names, IDs, serials, types, paths or issues. Enter: next; Shift+Enter: previous; Escape: clear." Padding="32,0,9,0" VerticalContentAlignment="Center" AutomationProperties.Name="Search devices"/>
     <ContentControl x:Name="SearchIcon" Width="16" Height="16" Margin="9,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Focusable="False"/>
     <TextBlock Text="Find a device…" Foreground="{DynamicResource TextSecondary}" Margin="33,0,9,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </Grid>
    <StackPanel x:Name="TitleRight" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" SizeChanged="TitleBarSizeChanged">
     <Button x:Name="InspectorButton" Visibility="Collapsed" Content="Show properties" Click="InspectorClick" Margin="0,0,6,0" Padding="8,4"/>
     <Button x:Name="ThemeButton" Content="Dark mode" Click="ThemeClick" Margin="0,0,6,0" Padding="8,4" Background="Transparent" BorderBrush="Transparent"/>
     <Button Content="Export…" Click="ExportClick" Margin="0,0,6,0" Padding="8,4"/>
     <!-- A split button: Refresh, and a chevron for its options, auto-refresh among them; a dot marks auto-refresh on. -->
     <StackPanel Orientation="Horizontal" AutomationProperties.Name="Refresh">
      <Button x:Name="RefreshButton" Click="RefreshClick" Padding="10,4" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Refresh">
       <StackPanel Orientation="Horizontal"><TextBlock Text="Refresh" Foreground="White"/><Ellipse x:Name="AutoRefreshDot" Width="6" Height="6" Fill="White" Margin="6,1,0,0" VerticalAlignment="Center" Visibility="Collapsed"/></StackPanel>
      </Button>
      <Button x:Name="RefreshMenuButton" Click="RefreshMenuClick" Padding="5,4" Margin="1,0,0,0" Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Refresh options">
       <Path Data="M0,0 L4,4 L8,0" Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"/>
      </Button>
     </StackPanel>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Row="1" SizeChanged="SidePanelsSizeChanged">
   <Grid.ColumnDefinitions><ColumnDefinition x:Name="TreeColumn" Width="280" MinWidth="180"/><ColumnDefinition x:Name="TreeSplitterColumn" Width="5"/><ColumnDefinition MinWidth="390"/><ColumnDefinition x:Name="SplitterColumn" Width="5"/><ColumnDefinition x:Name="InspectorColumn" Width="330" MinWidth="260" MaxWidth="520"/></Grid.ColumnDefinitions>
   <Border x:Name="TreePanel" Background="{DynamicResource Surface}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition/></Grid.RowDefinitions>
     <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="12,0"><DockPanel><Button DockPanel.Dock="Right" Content="Hide" Click="TreePanelClick" Padding="6,2" FontSize="12" ToolTip="Hide the device tree" AutomationProperties.Name="Hide devices"/><TextBlock Text="DEVICES" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/></DockPanel></Border>
     <TreeView x:Name="DeviceTree" Grid.Row="1" SelectedItemChanged="DeviceTreeSelectionChanged" PreviewMouseLeftButtonDown="DeviceTreeMouseDown" Background="{DynamicResource Surface}" Foreground="{DynamicResource TextPrimary}" BorderThickness="0" Padding="6,8" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="USB device tree">
      <TreeView.Resources>
       <Style TargetType="TreeViewItem">
        <Setter Property="Padding" Value="2,3,8,3"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TreeViewItem">
         <StackPanel>
          <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent" BorderThickness="3,0,0,0" CornerRadius="3" Padding="{TemplateBinding Padding}">
           <DockPanel>
            <ToggleButton x:Name="Expander" DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,3,0" Focusable="False" ClickMode="Press" Cursor="Hand" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
             <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
              <Border Background="Transparent"><Path x:Name="Chevron" Data="M0,0 L4,4 L0,8" Stroke="{DynamicResource TextMuted}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"/></Border>
              <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="90"/></Setter.Value></Setter></Trigger></ControlTemplate.Triggers>
             </ControlTemplate></ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center"/>
           </DockPanel>
          </Border>
          <ItemsPresenter x:Name="ItemsHost" Margin="12,0,0,0"/>
         </StackPanel>
         <ControlTemplate.Triggers>
          <Trigger Property="IsExpanded" Value="False"><Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/></Trigger>
          <Trigger Property="HasItems" Value="False"><Setter TargetName="Expander" Property="Visibility" Value="Hidden"/></Trigger>
          <Trigger SourceName="Row" Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource Hover}"/></Trigger>
          <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource SelectionStrong}"/><Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="PART_Header" Property="TextElement.FontWeight" Value="SemiBold"/></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
       </Style>
      </TreeView.Resources>
     </TreeView>
    </Grid>
   </Border>
   <GridSplitter x:Name="TreeSplitter" Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Divider}" ResizeBehavior="PreviousAndNext" DragCompleted="SplitterDragCompleted"/>
   <Grid Grid.Column="2" Background="{DynamicResource CanvasSurface}">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto" MinHeight="44"/></Grid.RowDefinitions>
    <StackPanel>
    <DockPanel Margin="16,0" Height="32">
     <TextBlock x:Name="TopologyTitle" Text="TOPOLOGY" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <TextBlock x:Name="MatchCount" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0"/>
      <Button x:Name="NextMatchButton" Content="Next ↓" Click="NextMatchClick" Padding="6,1" Visibility="Collapsed"/>
      <Button x:Name="FocusBranchButton" Content="Focus branch" Click="FocusBranchClick" Padding="6,1" Margin="8,0,0,0" ToolTip="Show the selected branch and its upstream path; click again to restore all branches"/>
      <Button x:Name="IssuesButton" Content="No issues" Click="IssuesClick" Padding="6,1" Margin="8,0,0,0"/>
     </StackPanel>
    </DockPanel>
    <!-- What to fix first: the few issues that matter most, each with its most likely fix (UiFixFirst). -->
    <Border x:Name="FixFirstPanel" Visibility="Collapsed" Margin="16,0,16,6" Padding="10,5,6,6" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="6" AutomationProperties.Name="Fix first">
     <DockPanel>
      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,2">
       <Button DockPanel.Dock="Right" Content="Hide" Click="HideFixFirstClick" Padding="6,1" FontSize="12" ToolTip="Hide until the issues change; the issue list keeps them" AutomationProperties.Name="Hide fix first"/>
       <TextBlock Text="FIX FIRST" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
      </DockPanel>
      <StackPanel x:Name="FixFirstList"/>
     </DockPanel>
    </Border>
    </StackPanel>
    <ScrollViewer Grid.Row="1" x:Name="GraphScroll" SizeChanged="GraphSizeChanged" ScrollChanged="GraphScrollChanged" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="GraphWheel" PreviewMouseDown="PanStart" PreviewMouseMove="PanMove" PreviewMouseUp="PanEnd" LostMouseCapture="PanCaptureLost" Background="Transparent">
     <Border Background="Transparent" HorizontalAlignment="Center" VerticalAlignment="Top"><Border.RenderTransform><TranslateTransform x:Name="PanTransform"/></Border.RenderTransform>
      <Canvas x:Name="Graph" Width="900" Height="600" VerticalAlignment="Top" HorizontalAlignment="Center" UseLayoutRounding="False" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="Grayscale"><Canvas.LayoutTransform><ScaleTransform x:Name="GraphScale" ScaleX="1" ScaleY="1"/></Canvas.LayoutTransform></Canvas>
     </Border>
    </ScrollViewer>
    <ProgressBar x:Name="RefreshProgress" Grid.Row="1" Panel.ZIndex="5" Height="4" VerticalAlignment="Top" Foreground="{DynamicResource Accent}" Background="{DynamicResource Selection}" BorderThickness="0" Visibility="Collapsed" Opacity="0" IsHitTestVisible="False" Focusable="False" AutomationProperties.Name="Refreshing USB topology"/>
    <TextBlock Grid.Row="1" x:Name="EmptyMessage" Text="Reading your USB connections…" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="14" IsHitTestVisible="False"/>
    <!-- Map-style view controls: compact glyph buttons in floating cards, layout above fitting above zoom. -->
    <StackPanel x:Name="ViewControls" Grid.Row="1" Panel.ZIndex="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,12" AutomationProperties.Name="View controls">
     <StackPanel.Resources>
      <Style x:Key="ViewCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Border}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="1"/><Setter Property="Margin" Value="0,6,0,0"/><Setter Property="HorizontalAlignment" Value="Right"/><Setter Property="Effect"><Setter.Value><DropShadowEffect BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.16"/></Setter.Value></Setter></Style>
      <Style x:Key="ViewButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Padding" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
      <Style x:Key="ViewGlyph" TargetType="Path"><Setter Property="Width" Value="18"/><Setter Property="Height" Value="18"/><Setter Property="Stroke" Value="{DynamicResource TextPrimary}"/><Setter Property="StrokeThickness" Value="1.7"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/><Setter Property="LayoutTransform"><Setter.Value><ScaleTransform ScaleX="0.75" ScaleY="0.75"/></Setter.Value></Setter></Style>
     </StackPanel.Resources>
     <Border Style="{StaticResource ViewCard}" Margin="0" AutomationProperties.Name="Layout">
      <StackPanel>
       <Button x:Name="HorizontalLayoutButton" Style="{StaticResource ViewButton}" Click="LayoutChoiceClick" AutomationProperties.Name="Horizontal layout">
        <Path Style="{StaticResource ViewGlyph}" Data="M2,7 H6 V11 H2 Z M12,2 H16 V6 H12 Z M12,12 H16 V16 H12 Z M6,9 H9 M9,4 V14 M9,4 H12 M9,14 H12"/>
       </Button>
       <Button x:Name="VerticalLayoutButton" Style="{StaticResource ViewButton}" Margin="0,2,0,0" Click="LayoutChoiceClick" AutomationProperties.Name="Vertical layout">
        <Path Style="{StaticResource ViewGlyph}" Data="M7,2 V6 H11 V2 Z M2,12 V16 H6 V12 Z M12,12 V16 H16 V12 Z M9,6 V9 M4,9 H14 M4,9 V12 M14,9 V12"/>
       </Button>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource ViewCard}">
      <StackPanel>
       <Button x:Name="FindSelectionButton" Style="{StaticResource ViewButton}" Click="LocateClick" AutomationProperties.Name="Find selection">
        <Path Style="{StaticResource ViewGlyph}" Data="M9,4 A5,5 0 1 1 8.99,4 Z M9,1 V4 M9,14 V17 M1,9 H4 M14,9 H17"/>
       </Button>
       <Button x:Name="FitAllButton" Style="{StaticResource ViewButton}" Margin="0,1,0,0" Click="OverviewClick" AutomationProperties.Name="Fit all">
        <Path Style="{StaticResource ViewGlyph}" Data="M2,6 V2 H6 M12,2 H16 V6 M16,12 V16 H12 M6,16 H2 V12"/>
       </Button>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource ViewCard}" AutomationProperties.Name="Zoom">
      <StackPanel>
       <Button x:Name="ZoomInButton" Style="{StaticResource ViewButton}" Click="ZoomIn" AutomationProperties.Name="Zoom in">
        <Path Style="{StaticResource ViewGlyph}" Data="M9,3 V15 M3,9 H15"/>
       </Button>
       <Border Height="1" Margin="6,2" Background="{DynamicResource Divider}"/>
       <Button x:Name="ZoomOutButton" Style="{StaticResource ViewButton}" Click="ZoomOut" AutomationProperties.Name="Zoom out">
        <Path Style="{StaticResource ViewGlyph}" Data="M3,9 H15"/>
       </Button>
      </StackPanel>
     </Border>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="16,3,0,4" VerticalAlignment="Center"><WrapPanel x:Name="SocketLegend" Margin="0,0,16,0"/></StackPanel>
   </Grid>
   <GridSplitter x:Name="InspectorSplitter" Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{DynamicResource Divider}" ResizeBehavior="PreviousAndNext" DragCompleted="SplitterDragCompleted"/>
   <Border x:Name="InspectorPanel" Grid.Column="4" Background="{DynamicResource Surface}">
    <Grid><Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition/></Grid.RowDefinitions>
     <Border BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,0,1" Padding="14,0,8,0">
      <DockPanel>
       <Button DockPanel.Dock="Right" Content="Hide" Click="InspectorClick" Padding="6,2" Margin="5,2,0,2" FontSize="12" ToolTip="Hide properties" AutomationProperties.Name="Hide properties"/>
       <Button x:Name="CopyDetailsButton" DockPanel.Dock="Right" Click="CopyDetailsClick" Padding="6,2" Margin="0,2,0,2" FontSize="12" IsEnabled="False" ToolTip="Copy selected device details as JSON" AutomationProperties.Name="Copy selected device details">
        <StackPanel Orientation="Horizontal"><ContentControl x:Name="CopyDetailsIcon" Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center" Focusable="False"/><TextBlock Text="Copy" VerticalAlignment="Center"/></StackPanel>
       </Button>
       <TextBlock Text="PROPERTIES" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
      </DockPanel>
     </Border>
     <ScrollViewer x:Name="DetailsScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="Details" Margin="14,12,14,16"/></ScrollViewer>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="2" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Background="{DynamicResource Surface}" Padding="16,0">
   <DockPanel><TextBlock x:Name="StatusText" Text="Starting…" VerticalAlignment="Center" Foreground="{DynamicResource TextMuted}" FontSize="12" TextTrimming="CharacterEllipsis"/></DockPanel>
  </Border>
 </Grid>
</Window>
