<Project Sdk="Microsoft.NET.Sdk">
  <!-- usbatlas-cli: the app's scan, issues and explanations on the command line, and as an MCP server. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UsbAtlas.Cli</RootNamespace>
    <AssemblyName>usbatlas-cli</AssemblyName>
    <Version>1.3.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Authors>Wright Bagwell</Authors>
    <Copyright>Copyright (c) 2026 Wright Bagwell</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/HowdyMoto/UsbAtlas</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\UsbAtlas.Core\UsbAtlas.Core.csproj" />
  </ItemGroup>
</Project>
